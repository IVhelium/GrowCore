# Db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=growcoredb

# JWT
JWT_SECRET=your_jwt_secret
JWT_ACCESS_COOKIE_NAME=your_jwt_access_cookie_name
JWT_REFRESH_COOKIE_NAME=your_jwt_refresh_cookie_name

# Prefix
STORAGE_ROOT=/app/storage
MEDIA_URL=/media
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Seed
RUN_STAFF_SEED=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@growcore.local
SEED_ADMIN_PASSWORD=Admin123456

SEED_SUPPORT_USERNAME=support
SEED_SUPPORT_EMAIL=support@growcore.local
SEED_SUPPORT_PASSWORD=Support123456

UPDATE_SEEDED_USERS_PASSWORDS=false
