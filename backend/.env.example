ENV=production

# Supabase Session pooler string from Project > Connect.
DATABASE_URL=postgres://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

JWT_SECRET=<generate-a-long-random-secret>
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=none

FRONTEND_URL=https://your-frontend.vercel.app
ADDITIONAL_CORS_ORIGINS=

FILE_STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
CLOUDINARY_FOLDER=growcore

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

RUN_STAFF_SEED=true
RUN_CATALOG_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<strong-admin-password>
SEED_SUPPORT_USERNAME=support
SEED_SUPPORT_EMAIL=support@example.com
SEED_SUPPORT_PASSWORD=<strong-support-password>
UPDATE_SEEDED_USERS_PASSWORDS=true
